@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/OrganizationShape> a sh:NodeShape ;
    rdfs:label "Organization Shape" ;
    sh:closed true ;
    sh:description "A company or organization" ;
    sh:ignoredProperties rdf:type ;
    sh:property <https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/OrganizationShape/employees>,
        <https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/OrganizationShape/orgName> ;
    sh:targetClass <http://example.org/Organization> .

<https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/PersonShape> a sh:NodeShape ;
    rdfs:label "Person Shape" ;
    sh:closed true ;
    sh:description "A person in the system" ;
    sh:ignoredProperties rdf:type ;
    sh:property <https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/PersonShape/age>,
        <https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/PersonShape/email>,
        <https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/PersonShape/knows>,
        <https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/PersonShape/name>,
        <https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/PersonShape/worksFor> ;
    sh:targetClass <http://example.org/Person> .

<https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/OrganizationShape/employees> rdfs:label "employees" ;
    sh:class <http://example.org/Person> ;
    sh:description "People who work for this organization" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:path <http://example.org/employees> .

<https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/OrganizationShape/orgName> rdfs:label "orgName" ;
    sh:datatype xsd:string ;
    sh:description "Official name of the organization" ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:path <http://example.org/orgName> .

<https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/PersonShape/age> rdfs:label "age" ;
    sh:datatype xsd:integer ;
    sh:description "Age in years" ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:nodeKind sh:Literal ;
    sh:path <http://example.org/age> .

<https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/PersonShape/email> rdfs:label "email" ;
    sh:datatype xsd:string ;
    sh:description "Email addresses for contacting this person" ;
    sh:minCount 0 ;
    sh:nodeKind sh:Literal ;
    sh:path <http://example.org/email> .

<https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/PersonShape/knows> rdfs:label "knows" ;
    sh:class <http://example.org/Person> ;
    sh:description "Other people this person knows" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:path <http://example.org/knows> .

<https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/PersonShape/name> rdfs:label "name" ;
    sh:datatype xsd:string ;
    sh:description "Full name of the person" ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:path <http://example.org/name> .

<https://rdfsolve.bigcat-bioinformatics.nl/shapes/example_dataset/PersonShape/worksFor> rdfs:label "worksFor" ;
    sh:class <http://example.org/Organization> ;
    sh:description "Organization where this person is employed" ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:path <http://example.org/worksFor> .

