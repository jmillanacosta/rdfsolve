{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aopwikirdf",
  "description": null,
  "$defs": {
    "Person": {
      "type": "object",
      "title": "Person",
      "properties": {
        "name": {
          "type": "string",
          "title": "Name",
          "description": "Full name of the person",
          "examples": [
            "Alice Smith",
            "Bob Jones",
            "Charlie Brown"
          ]
        },
        "email": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": null,
          "title": "Email",
          "description": "Email addresses for contacting this person",
          "examples": [
            "alice@example.com",
            "bob@company.org"
          ]
        },
        "age": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age",
          "description": "Age in years",
          "examples": [
            "25",
            "42",
            "67"
          ]
        },
        "knows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Person"
          },
          "default": null,
          "title": "Knows",
          "description": "Other people this person knows"
        },
        "worksFor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Organization"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worksfor",
          "description": "Organization where this person is employed"
        }
      },
      "description": "A person in the system",
      "required": [
        "name"
      ]
    },
    "Organization": {
      "type": "object",
      "title": "Organization",
      "properties": {
        "orgName": {
          "type": "string",
          "title": "Orgname",
          "description": "Official name of the organization",
          "examples": [
            "Acme Corp",
            "Example Inc",
            "Test LLC"
          ]
        },
        "employees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Person"
          },
          "default": null,
          "title": "Employees",
          "description": "People who work for this organization"
        }
      },
      "description": "A company or organization",
      "required": [
        "orgName"
      ]
    }
  }
}