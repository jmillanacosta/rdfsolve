<https://identifiers.org/aop.relationships/681> a aopo:KeyEventRelationship ;
    rdfs:label "KER 681" ;
    aopo:has_downstream_key_event <https://identifiers.org/aop.events/681> ;
    aopo:has_upstream_key_event <https://identifiers.org/aop.events/79> ;
