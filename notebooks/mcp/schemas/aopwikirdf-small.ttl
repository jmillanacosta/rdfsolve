<https://identifiers.org/aop.relationships/682> a aopo:KeyEventRelationship ;
    rdfs:label "KER 682" ;
    aopo:has_downstream_key_event <https://identifiers.org/aop.events/671> ;
    aopo:has_upstream_key_event <https://identifiers.org/aop.events/681> ;
    dc:identifier <https://identifiers.org/aop.relationships/682> ;
