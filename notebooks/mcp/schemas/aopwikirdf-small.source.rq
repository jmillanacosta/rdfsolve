CONSTRUCT { ?s ?p ?o . ?o ?q ?v . ?v a ?type . } WHERE {
      { SELECT ?s WHERE { ?s a <http://aopkb.org/aop_ontology#AdverseOutcomePathway> } ORDER BY ?s LIMIT 8 }
      ?s ?p ?o .
      FILTER(!isIRI(?o) || REGEX(STR(?o), "^[A-Za-z][A-Za-z0-9+.-]*:"))
      OPTIONAL { FILTER(isIRI(?o)) ?o ?q ?v . FILTER(!isIRI(?v) || REGEX(STR(?v), "^[A-Za-z][A-Za-z0-9+.-]*:")) OPTIONAL { ?v a ?type } }
    }