    foaf:page ns35:WP5289_r140108 .

ns27:WP5510_r139934 a wp:Pathway,
        skos:Collection ;
    dc:identifier ns27:WP5510 ;
    dc:source "WikiPathways" ;
    dc:title "16p12.2 copy number variation syndrome (520kb)"@en ;
    dcterms:description "Copy number variations in the region 16p12.2 (exact position on the chromosome: Chr16:21950135-22431889 (GRCh37), are rare, pathological mutations in the human genome. It is a risk variation for neuropsychiatric diseases like schizophrenia (Kirov et al. 2014, [10.1016/j.biopsych.2013.07.022](https://doi.org/10.1016/j.biopsych.2013.07.022))" ;
    dcterms:identifier "WP5510" ;
