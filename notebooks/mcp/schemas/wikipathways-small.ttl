ns27:WP5496_r140910 a wp:Pathway,
        skos:Collection ;
    dc:identifier ns27:WP5496 ;
    dc:source "WikiPathways" ;
    dc:title "Targeted therapy in breast cancer"@en ;
    dcterms:description "\"Trastuzumab and pertuzumab inhibit HER2 signaling by binding to the extracellular domain of HER2. Lapatinib, neratinib, tucatinib, and pyrotinib inhibit HER signaling by binding to the intracellular tyrosine kinase domain of the Her family members.\".  Source: Figure F1, https://pmc.ncbi.nlm.nih.gov/articles/PMC9281252/.  Derived from PFOCR, https://pfocr.wikipathways.org/figures/PMC9281252__12032_2022_1749_Fig1_HTML.html." ;
    dcterms:identifier "WP5496" ;
