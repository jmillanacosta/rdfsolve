ns27:WP5426_r136865 a wp:Pathway,
        skos:Collection ;
    dc:identifier ns27:WP5426 ;
    dc:source "WikiPathways" ;
    dc:title "HDAC6 interactions in the central nervous system"@en ;
    dcterms:description """HDAC6 stands out as a distinctive member within the histone deacetylase family due to its predominant presence in the cytosol, facilitating its interaction with a wide array of non-histone proteins. Its dysregulation has been linked to various outcomes, encompassing diverse cancer types, immune-related disorders, and neurological conditions, including Alzheimer's, Parkinson's, ALS, Huntington's, Charcot-Marie-Tooth disease, and Rett syndrome.
The current network represents the known HDAC6 interactions in the central nervous system (CNS).""" ;
    dcterms:identifier "WP5426" ;
    ns36:cites <https://identifiers.org/pubmed/12024216>,
        <https://identifiers.org/pubmed/14675537>,
        <https://identifiers.org/pubmed/15767577>,
        <https://identifiers.org/pubmed/15831498>,
