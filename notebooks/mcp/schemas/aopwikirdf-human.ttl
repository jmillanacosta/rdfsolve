<https://identifiers.org/aop.relationships/442> a aopo:KeyEventRelationship ;
    rdfs:label "KER 442" ;
    aopo:LifeStageContext "During brain development" ;
    aopo:has_downstream_key_event <https://identifiers.org/aop.events/425> ;
