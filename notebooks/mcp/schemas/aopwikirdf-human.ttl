<https://identifiers.org/aop.relationships/1508> a aopo:KeyEventRelationship ;
    rdfs:label "KER 1508" ;
    aopo:LifeStageContext "All life stages" ;
    aopo:has_downstream_key_event <https://identifiers.org/aop.events/979> ;
    aopo:has_upstream_key_event <https://identifiers.org/aop.events/980> ;
    edam:data_1025 <https://identifiers.org/hgnc/10640>,
        <https://identifiers.org/hgnc/1449>,
        <https://identifiers.org/hgnc/15702>,
        <https://identifiers.org/hgnc/17819>,
