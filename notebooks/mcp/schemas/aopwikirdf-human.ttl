<https://identifiers.org/aop.events/757> a aopo:KeyEvent ;
    rdfs:label "KE 757" ;
    aopo:LifeStageContext "During brain development" ;
    aopo:OrganContext ns1:UBERON_0000955 ;
    edam:data_1025 <https://identifiers.org/hgnc/1033>,
        <https://identifiers.org/hgnc/11132>,
        <https://identifiers.org/hgnc/11494>,
        <https://identifiers.org/hgnc/11506>,
