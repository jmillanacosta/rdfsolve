        <https://identifiers.org/hgnc/2714>,
        <https://identifiers.org/hgnc/7960>,
        <https://identifiers.org/hgnc/7998>,
        <https://identifiers.org/hgnc/8016>,
        <https://identifiers.org/hgnc/8574>,
        <https://identifiers.org/hgnc/9957> ;
