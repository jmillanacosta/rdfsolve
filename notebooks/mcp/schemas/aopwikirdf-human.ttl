<https://identifiers.org/aop.relationships/164> a aopo:KeyEventRelationship ;
    rdfs:label "KER 164" ;
    aopo:LifeStageContext "All life stages" ;
    aopo:has_downstream_key_event <https://identifiers.org/aop.events/185> ;
    aopo:has_upstream_key_event <https://identifiers.org/aop.events/155> ;
    edam:data_1025 <https://identifiers.org/hgnc/11830>,
        <https://identifiers.org/hgnc/12814>,
        <https://identifiers.org/hgnc/12816>,
        <https://identifiers.org/hgnc/12833>,
