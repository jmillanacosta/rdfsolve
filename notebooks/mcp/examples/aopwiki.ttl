<urn:rdfsolve:query:010cb62bb90c6820c3f8d41fbbfba42a5d0c2366f62129fac3d430b38879eb47> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Count AOPs" ;
    rdfs:comment "Returns the total number of Adverse Outcome Pathways in the dataset." ;
    sh:prefixes <urn:rdfsolve:prefixes:c7e7571b7e5b3d8e2d87366a4a961493ed220d4398b2fd5e51409db74786086d> ;
    sh:select """# title: Count AOPs
# description: Returns the total number of Adverse Outcome Pathways in the dataset.
# category: Metadata

SELECT (COUNT(DISTINCT ?aop) AS ?total_AOPs)
WHERE {
  ?aop a aopo:AdverseOutcomePathway .
}
""" ;
    schema:isBasedOn <urn:sha256:548844577d7ade2a5779040667ce3b4251447fb8b1eb9c5f9cbc0552f89b3b50> ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    schema:url <https://github.com/marvinm2/AOP-Wiki-Queries/blob/392f365865c387b62f3fea635f04be0de04ed519/A.%20Metadata/count-aops.rq> .

<urn:rdfsolve:query:0565eaeb0ef99899c9cc095f3571587b6fc1ad7e9f00cdf8c0e1d9364a91265e> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Genes found only by BERN2 NER (not by regex)" ;
    rdfs:comment "Lists gene-Key Event associations detected by the BERN2 NER+EL mapper that the legacy regex mapper did not find. These are the net-new genes contributed by named-entity recognition over Key Event descriptions." ;
    sh:prefixes <urn:rdfsolve:prefixes:c7e7571b7e5b3d8e2d87366a4a961493ed220d4398b2fd5e51409db74786086d> ;
    sh:select """# title: Genes found only by BERN2 NER (not by regex)
# description: Lists gene-Key Event associations detected by the BERN2 NER+EL mapper that the legacy regex mapper did not find. These are the net-new genes contributed by named-entity recognition over Key Event descriptions.
# category: Key Events

PREFIX p: <https://aopwiki.rdf.bigcat-bioinformatics.org/>

SELECT ?ke ?ketitle ?gene ?symbol
WHERE {
  ?ke p:geneDetectedByNER ?gene .
  FILTER NOT EXISTS { ?ke p:geneDetectedByRegex ?gene }
  OPTIONAL { ?ke dc:title ?ketitle }
  OPTIONAL { ?gene rdfs:label ?symbol }
}
ORDER BY ?ke
""" ;
    schema:isBasedOn <urn:sha256:548844577d7ade2a5779040667ce3b4251447fb8b1eb9c5f9cbc0552f89b3b50> ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    schema:url <https://github.com/marvinm2/AOP-Wiki-Queries/blob/392f365865c387b62f3fea635f04be0de04ed519/C.%20Key%20Events/genes-found-only-by-ner.rq> .

<urn:rdfsolve:query:08dce83c1d567f0e38e7f2b863a2d455d58e60143fe45423f77151b16db7634d> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Count Key Event Relationships" ;
