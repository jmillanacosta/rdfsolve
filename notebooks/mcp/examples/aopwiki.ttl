    rdfs:label "List Key Events with annotated UniProt IDs" ;
    rdfs:comment "Returns Key Events with their annotated protein objects and linked UniProt identifiers, through AOP membership." ;
    sh:prefixes <urn:rdfsolve:prefixes:c7e7571b7e5b3d8e2d87366a4a961493ed220d4398b2fd5e51409db74786086d> ;
    sh:select """# title: List Key Events with annotated UniProt IDs
# description: Returns Key Events with their annotated protein objects and linked UniProt identifiers, through AOP membership.
# category: Key Events

SELECT DISTINCT ?keid ?ketitle ?objectname ?uniprotID ?uniprot
WHERE {
  ?aop a aopo:AdverseOutcomePathway ;
    rdfs:label ?aop_id ;
    aopo:has_key_event ?ke .
  ?ke pato:0001241 ?object ;
    dc:title ?ketitle ;
    rdfs:label ?keid .
  ?object dc:title ?objectname ;
    skos:exactMatch ?uniprot .
  ?uniprot a edam:data_2291 ;
    edam:data_2291 ?uniprotID .
}
""" ;
    schema:isBasedOn <urn:sha256:548844577d7ade2a5779040667ce3b4251447fb8b1eb9c5f9cbc0552f89b3b50> ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    schema:url <https://github.com/marvinm2/AOP-Wiki-Queries/blob/392f365865c387b62f3fea635f04be0de04ed519/C.%20Key%20Events/kes-and-uniprot-annotated.rq> .

<urn:rdfsolve:query:c7d664757974c494e0fd600ea4a5464f6622c805862e62e43e6b585e7e1eaec0> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Find AOs for all MIEs" ;
    rdfs:comment "Returns all Molecular Initiating Event to Adverse Outcome links across every AOP. For a single MIE with an autocomplete picker, use \"Get AO for a specific MIE\"." ;
    sh:prefixes <urn:rdfsolve:prefixes:c7e7571b7e5b3d8e2d87366a4a961493ed220d4398b2fd5e51409db74786086d> ;
    sh:select """# title: Find AOs for all MIEs
# description: Returns all Molecular Initiating Event to Adverse Outcome links across every AOP. For a single MIE with an autocomplete picker, use "Get AO for a specific MIE".
# category: AOPs

SELECT DISTINCT ?MIE ?MolecularInitiatingEventName ?AOwebpage ?AdverseOutcomeName
WHERE {
  ?MIE dc:identifier ?MIELookup ;
    dc:title ?MolecularInitiatingEventName .
  ?AOPwebpage a aopo:AdverseOutcomePathway ;
    aopo:has_molecular_initiating_event ?MIELookup ;
    aopo:has_adverse_outcome ?AOwebpage .
  ?AOwebpage dc:title ?AdverseOutcomeName .
}
""" ;
    schema:isBasedOn <urn:sha256:548844577d7ade2a5779040667ce3b4251447fb8b1eb9c5f9cbc0552f89b3b50> ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    schema:url <https://github.com/marvinm2/AOP-Wiki-Queries/blob/392f365865c387b62f3fea635f04be0de04ed519/B.%20AOPs/ao-for-mie.rq> .

<urn:rdfsolve:query:ca2a8856a1d8794aea3d6df6c8c798c823cbc3c6bd3e7554bc197056ab117c02> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Find ToxCast assays for Key Events" ;
    rdfs:comment "Returns Key Events with their annotated proteins and linked ToxCast assay information from the AOP-DB endpoint." ;
    sh:prefixes <urn:rdfsolve:prefixes:c7e7571b7e5b3d8e2d87366a4a961493ed220d4398b2fd5e51409db74786086d> ;
    sh:select """# title: Find ToxCast assays for Key Events
# description: Returns Key Events with their annotated proteins and linked ToxCast assay information from the AOP-DB endpoint.
# category: Federated

SELECT DISTINCT ?keid ?ketitle ?objectname ?prot ?assaytitle ?assay
WHERE {
  ?aop a aopo:AdverseOutcomePathway ;
    rdfs:label ?aop_id ;
    aopo:has_key_event ?ke .
  ?ke pato:0001241 ?object ;
    dc:title ?ketitle ;
    rdfs:label ?keid .
  ?object dc:title ?objectname ;
    skos:exactMatch ?prot .
  ?prot a edam:data_1027 .
  SERVICE <https://aopdb.rdf.bigcat-bioinformatics.org/sparql> {
    ?prot mmo:0000441 ?assay .
    ?assay dc:title ?assaytitle .
  }
}
""" ;
    schema:isBasedOn <urn:sha256:548844577d7ade2a5779040667ce3b4251447fb8b1eb9c5f9cbc0552f89b3b50> ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    schema:url <https://github.com/marvinm2/AOP-Wiki-Queries/blob/392f365865c387b62f3fea635f04be0de04ed519/H.%20Federated/toxcast-assays-for-kes.rq> .

<urn:rdfsolve:query:e52ed5ee047c1f71d269c3e15629393e783a4d6fc3aa86ede4d6796741695d6e> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Count Key Events" ;
    rdfs:comment "Returns the total number of Key Events in the dataset." ;
    sh:prefixes <urn:rdfsolve:prefixes:c7e7571b7e5b3d8e2d87366a4a961493ed220d4398b2fd5e51409db74786086d> ;
    sh:select """# title: Count Key Events
# description: Returns the total number of Key Events in the dataset.
# category: Metadata

SELECT (COUNT(DISTINCT ?ke) AS ?total_KEs)
WHERE {
  ?ke a aopo:KeyEvent .
}
""" ;
    schema:isBasedOn <urn:sha256:548844577d7ade2a5779040667ce3b4251447fb8b1eb9c5f9cbc0552f89b3b50> ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    schema:url <https://github.com/marvinm2/AOP-Wiki-Queries/blob/392f365865c387b62f3fea635f04be0de04ed519/A.%20Metadata/count-kes.rq> .

<urn:rdfsolve:query:e64034dc2b95022269f41af288ea3e0618257269371e798c4fe51479a954e935> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Count predicates using AOP ontology" ;
    rdfs:comment "Returns the number of RDF predicates that reference the AOP ontology namespace." ;
    sh:prefixes <urn:rdfsolve:prefixes:c7e7571b7e5b3d8e2d87366a4a961493ed220d4398b2fd5e51409db74786086d> ;
    sh:select """# title: Count predicates using AOP ontology
# description: Returns the number of RDF predicates that reference the AOP ontology namespace.
# category: Metadata

SELECT (COUNT(?p) AS ?Predicates)
WHERE {
  ?s ?p ?o .
  FILTER regex(?p, "http://aopkb.org/aop_ontology#")
}
""" ;
    schema:isBasedOn <urn:sha256:548844577d7ade2a5779040667ce3b4251447fb8b1eb9c5f9cbc0552f89b3b50> ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    schema:url <https://github.com/marvinm2/AOP-Wiki-Queries/blob/392f365865c387b62f3fea635f04be0de04ed519/A.%20Metadata/count-predicates-aop-ontology.rq> .

<urn:rdfsolve:query:eb3adc0a07f92d3fa47f3669dfb985cbdd0fb9d7cb846e48a482ef25c484df7a> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Get dataset metadata" ;
    rdfs:comment "Returns the VoID dataset description and creation date for the AOP-Wiki RDF dataset." ;
    sh:prefixes <urn:rdfsolve:prefixes:c7e7571b7e5b3d8e2d87366a4a961493ed220d4398b2fd5e51409db74786086d> ;
    sh:select """# title: Get dataset metadata
# description: Returns the VoID dataset description and creation date for the AOP-Wiki RDF dataset.
# category: Metadata

SELECT DISTINCT ?dataset ?date
WHERE {
  ?dataset a void:Dataset ;
    pav:createdOn ?date .
}
""" ;
    schema:isBasedOn <urn:sha256:548844577d7ade2a5779040667ce3b4251447fb8b1eb9c5f9cbc0552f89b3b50> ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    schema:url <https://github.com/marvinm2/AOP-Wiki-Queries/blob/392f365865c387b62f3fea635f04be0de04ed519/A.%20Metadata/dataset-metadata.rq> .

<urn:rdfsolve:query:f1d9bb04242355099e3b1aacec4aa604d8adad05141118ecfa0bfde0f6f79fcb> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Gene detection method summary (regex vs BERN2 NER)" ;
    rdfs:comment "Counts gene-Key Event associations by detection method. edam:data_1025 holds the union of all detected genes; :geneDetectedByRegex and :geneDetectedByNER record provenance. Shows total NER associations, how many were also found by the regex mapper, and how many were found only by NER." ;
    sh:prefixes <urn:rdfsolve:prefixes:c7e7571b7e5b3d8e2d87366a4a961493ed220d4398b2fd5e51409db74786086d> ;
    sh:select """# title: Gene detection method summary (regex vs BERN2 NER)
# description: Counts gene-Key Event associations by detection method. edam:data_1025 holds the union of all detected genes; :geneDetectedByRegex and :geneDetectedByNER record provenance. Shows total NER associations, how many were also found by the regex mapper, and how many were found only by NER.
# category: Key Events

PREFIX p: <https://aopwiki.rdf.bigcat-bioinformatics.org/>

SELECT
  (COUNT(*) AS ?ner_total)
  (SUM(IF(EXISTS { ?ke p:geneDetectedByRegex ?gene }, 1, 0)) AS ?ner_and_regex)
  (SUM(IF(EXISTS { ?ke p:geneDetectedByRegex ?gene }, 0, 1)) AS ?ner_only)
WHERE {
  ?ke p:geneDetectedByNER ?gene .
}
""" ;
    schema:isBasedOn <urn:sha256:548844577d7ade2a5779040667ce3b4251447fb8b1eb9c5f9cbc0552f89b3b50> ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    schema:url <https://github.com/marvinm2/AOP-Wiki-Queries/blob/392f365865c387b62f3fea635f04be0de04ed519/C.%20Key%20Events/gene-detection-method-summary.rq> .

