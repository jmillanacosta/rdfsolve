<urn:rdfsolve:query:2ccd827a0946b6e7769507fa88e5a922d3305078d49dd39f7b8a913e2772efec> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Export all Key Event components" ;
    rdfs:comment "Returns all Key Events with their biological event components including processes, objects, and actions." ;
    sh:prefixes <urn:rdfsolve:prefixes:c7e7571b7e5b3d8e2d87366a4a961493ed220d4398b2fd5e51409db74786086d> ;
    sh:select """# title: Export all Key Event components
# description: Returns all Key Events with their biological event components including processes, objects, and actions.
# category: Data Export

SELECT DISTINCT ?ke ?keTitle ?bioEvent
  ?process ?processName ?object ?objectName ?action
WHERE {
  ?ke a aopo:KeyEvent ;
    dc:title ?keTitle .
  OPTIONAL {
    ?ke aopo:hasBiologicalEvent ?bioEvent .
    ?bioEvent aopo:hasProcess ?process .
    ?process dc:title ?processName .
  }
  OPTIONAL {
    ?ke aopo:hasBiologicalEvent ?bioEvent .
    ?bioEvent aopo:hasObject ?object .
    ?object dc:title ?objectName .
  }
  OPTIONAL {
    ?ke aopo:hasBiologicalEvent ?bioEvent .
    ?bioEvent aopo:hasAction ?action .
  }
}
ORDER BY ?ke
""" ;
    schema:isBasedOn <urn:sha256:548844577d7ade2a5779040667ce3b4251447fb8b1eb9c5f9cbc0552f89b3b50> ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    schema:url <https://github.com/marvinm2/AOP-Wiki-Queries/blob/392f365865c387b62f3fea635f04be0de04ed519/G.%20Data%20Export/all-ke-components.rq> .

<urn:rdfsolve:query:31d7c2fd15b54d4e04a93725483f4754f8117bbb82c5de614252c011852ebb58> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Count objects using AOP ontology" ;
    rdfs:comment "Returns the number of RDF objects that reference the AOP ontology namespace." ;
    sh:prefixes <urn:rdfsolve:prefixes:c7e7571b7e5b3d8e2d87366a4a961493ed220d4398b2fd5e51409db74786086d> ;
    sh:select """# title: Count objects using AOP ontology
# description: Returns the number of RDF objects that reference the AOP ontology namespace.
# category: Metadata

SELECT (COUNT(?o) AS ?Objects)
WHERE {
  ?s ?p ?o .
  FILTER regex(?o, "http://aopkb.org/aop_ontology#")
}
""" ;
    schema:isBasedOn <urn:sha256:548844577d7ade2a5779040667ce3b4251447fb8b1eb9c5f9cbc0552f89b3b50> ;
