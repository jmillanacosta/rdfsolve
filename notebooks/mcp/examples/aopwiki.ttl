<urn:rdfsolve:query:6c6f15c4ebc46893754cd704e49ce38ea3b20c90ddf415f554f781e305a0aa8b> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "List Key Events with Ensembl IDs" ;
