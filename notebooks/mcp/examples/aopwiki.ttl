<urn:rdfsolve:query:9b9454d92856e5e14da47486ae3e905bf315c5df4bcfd4b72a9a661b77d787f7> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Map Key Events to AOPs" ;
    rdfs:comment "Returns all Key Events and the Adverse Outcome Pathways they belong to, ordered by Key Event name." ;
    sh:prefixes <urn:rdfsolve:prefixes:c7e7571b7e5b3d8e2d87366a4a961493ed220d4398b2fd5e51409db74786086d> ;
    sh:select """# title: Map Key Events to AOPs
# description: Returns all Key Events and the Adverse Outcome Pathways they belong to, ordered by Key Event name.
# category: Key Events

SELECT DISTINCT ?ke ?keLabel ?aop ?aopLabel
WHERE {
  ?aop a aopo:AdverseOutcomePathway ;
    aopo:has_key_event ?ke ;
    dc:title ?aopLabel .
  ?ke dc:title ?keLabel .
}
ORDER BY ?keLabel
""" ;
