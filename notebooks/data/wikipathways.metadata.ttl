<https://raw.githubusercontent.com/wikipathways/WikiPathwaysLoader/master/data/chebi-slim.ttl> a void:Dataset ;
    dcterms:accrualPeriodicity <http://purl.org/cld/freq/monthly> ;
    dcterms:description "Chemical Entities of Biological Interest, also known as ChEBI, is a chemical database and ontology of molecular entities focused on 'small' chemical compounds, that is part of the Open Biomedical Ontologies (OBO) effort at the European Bioinformatics Institute (EBI). Slimmed with the eNanoMapper Slimmer to the ChEBI terms that WikiPathways actually annotates with, queried live from the endpoint (wp:bdbChEBI), rather than the full ChEBI release." ;
    dcterms:issued "2026-07-07"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "ChEBI Ontology (WikiPathways slim)" ;
    ns1:createdBy <https://github.com/wikipathways/WikiPathwaysLoader/blob/master/.github/workflows/build-imports.yml> ;
    ns1:createdWith <https://github.com/enanomapper/slimmer/releases/tag/v1.0.1>,
        <https://github.com/ontodev/robot/releases/tag/v1.9.0> ;
    ns1:derivedFrom <http://purl.enanomapper.net/onto/external/chebi-slim.owl> ;
    ns1:importedBy <https://github.com/wikipathways/WikiPathwaysLoader/blob/master/.github/workflows/build-imports.yml> ;
    ns1:importedFrom <http://ftp.ebi.ac.uk/pub/databases/chebi/ontology/chebi_lite.obo> ;
    ns1:version "253" ;
    void:classes 7291 ;
    void:dataDump <https://raw.githubusercontent.com/wikipathways/WikiPathwaysLoader/master/data/chebi-slim.ttl> ;
    void:exampleResource <http://purl.obolibrary.org/obo/CHEBI_90> ;
    void:feature <http://www.w3.org/ns/formats/Turtle> ;
    void:triples 60768 ;
    void:uriSpace "http://purl.obolibrary.org/obo/CHEBI_" ;
