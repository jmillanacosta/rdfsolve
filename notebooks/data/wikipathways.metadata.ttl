<https://raw.githubusercontent.com/wikipathways/WikiPathwaysLoader/master/data/DiseaseOntology.ttl> a void:Dataset ;
    dcterms:accrualPeriodicity <http://purl.org/cld/freq/monthly> ;
    dcterms:description "The Disease Ontology has been developed as a standardized ontology for human disease with the purpose of providing the biomedical community with consistent, reusable and sustainable descriptions of human disease terms, phenotype characteristics and related medical vocabulary disease concepts." ;
